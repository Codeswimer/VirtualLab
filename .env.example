# Frontend build-time configuration.
# Leave blank when the API serves the built app from the same origin (recommended),
# or when using the Vite dev proxy.
VITE_API_BASE_URL=

# Server configuration is read from the shell environment, not this file.
# PORT=4000
# HOST=0.0.0.0
# DATA_DIR=./server/data
# DB_PATH=
# CORS_ORIGIN=https://lab.example.org

# AI challenge generator (server-side only — never expose this in the browser).
# Get a key from Google AI Studio, then paste it into a local .env file.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
