{
  "name": "virtual-lab-nigeria",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Virtual Physics & Chemistry Laboratory for Nigerian senior secondary schools (SS1–SS3)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node --test server/app.test.mjs",
    "seed:reset": "node scripts/reset-db.mjs",
    "check:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "@fontsource-variable/manrope": "^5.1.1",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/rapier": "^1.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.64.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.5",
    "workbox-window": "^7.4.1"
  }
}
